# ==============================================================================
# Sankofa SMS — Ghana Private Basic School Management System (Neon Stack)
# Copy this file to .env or run `neon deploy` / `neon env pull`
# ==============================================================================

# 1. Neon Postgres (pooled for app queries, unpooled for Prisma migrations/push)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Neon Branch & Functions (pulled by `neon deploy` / `neon env pull`)
NEON_BRANCH="production"
NEON_BRANCH_ID="br-xxxxxxxx-xxxxxxxx"
NEON_FUNCTION_HOST_SUFFIX=".compute.c-9.us-east-2.aws.neon.tech"

# 3. Neon Auth — Managed Better Auth
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Generate with: openssl rand -base64 32 (32+ characters)
NEON_AUTH_COOKIE_SECRET="replace-with-a-strong-random-32-plus-character-secret"

# 4. Neon AI Gateway
NEON_AI_GATEWAY_BASE_URL="https://br-xxx-api.ai.us-east-2.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN="nt_live_replace_with_branch_token"

# 5. Neon Realtime (Live SQL)
NEON_REALTIME_URL="wss://ep-xxx.realtime.us-east-2.aws.neon.tech/v1/ws"
NEON_REALTIME_SECRET="replace-with-neon-realtime-secret"
NEXT_PUBLIC_NEON_REALTIME_URL="$NEON_REALTIME_URL"

# 6. App RBAC Session Signing Secret (REQUIRED — use 32+ random characters)
AUTH_SECRET="replace-with-a-strong-random-32-plus-character-secret"

# 7. Paystack Ghana Payment Gateway (OPTIONAL — leave placeholders for Simulation Mode)
PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"

# 8. Ghanaian SMS Gateway — Arkesel or Hubtel (OPTIONAL — leave keys blank for SMS Outbox Log Mode)
SMS_PROVIDER="ARKESEL"
ARKESEL_API_KEY=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
SMS_SENDER_ID="SankofaSch"
