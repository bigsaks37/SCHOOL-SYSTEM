# ==============================================================================
# Sankofa SMS — Ghana Private Basic School Management System
# Copy this file to .env (local) or configure these variables in Vercel / Render
# ==============================================================================

# 1. Cloud PostgreSQL Connection String (REQUIRED)
# Examples:
#   Neon:     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
#   Render:   postgresql://user:pass@dpg-xxx-a.oregon-postgres.render.com/sankofa_sms?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sankofa_sms?sslmode=require"

# 2. JWT Authentication Signing Secret (REQUIRED — use 32+ random characters)
AUTH_SECRET="replace-with-a-strong-random-32-plus-character-secret"

# 3. Paystack Ghana Payment Gateway (OPTIONAL — leave placeholders for Simulation Mode)
PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"

# 4. Ghanaian SMS Gateway — Arkesel or Hubtel (OPTIONAL — leave keys blank for SMS Outbox Log Mode)
SMS_PROVIDER="ARKESEL"
ARKESEL_API_KEY=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
SMS_SENDER_ID="SankofaSch"
