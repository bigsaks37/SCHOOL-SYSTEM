{
  "name": "sankofa-school-sms",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first School Management System for Private Basic Schools in Ghana",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "node scripts/db-sync.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma db push && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/ai-sdk-provider": "^1.4.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@neon/realtime-react": "^0.2.0",
    "@prisma/client": "^6.10.0",
    "ai": "^7.0.179",
    "bcryptjs": "^2.4.3",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "ws": "^8.23.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
